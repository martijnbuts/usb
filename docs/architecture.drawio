<mxfile host="drawio"><diagram id="arch" name="How it works"><mxGraphModel background="#ffffff" grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="dev" value="&lt;b&gt;USB devices&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;mouse · keyboard&lt;br&gt;combo receiver · hub&lt;br&gt;remote · gamepad&lt;br&gt;touch screen · IR receiver&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="130" width="150" height="110" as="geometry"/></mxCell><mxCell id="fork" value="p1ngb4ck/esphome fork  (pinned commit 4e93938)" style="swimlane;startSize=28;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="220" y="60" width="660" height="240" as="geometry"/></mxCell><mxCell id="host" value="&lt;b&gt;usb_host&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:11px&quot;&gt;espressif/usb 1.4.1 (patched)&lt;br&gt;enumerates devices, hubs&lt;br&gt;hands each device to a client&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=4;" vertex="1" parent="fork"><mxGeometry x="20" y="70" width="190" height="120" as="geometry"/></mxCell><mxCell id="hidc" value="&lt;b&gt;usb_hid&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:11px&quot;&gt;one entry per device&lt;br&gt;claims HID interfaces&lt;br&gt;reads report descriptor&lt;br&gt;interrupt-IN reports&lt;br&gt;+ drivers: Xbox, PlayStation,&lt;br&gt;Switch, Steam, MCE IR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=4;" vertex="1" parent="fork"><mxGeometry x="240" y="60" width="190" height="135" as="geometry"/></mxCell><mxCell id="hid" value="&lt;b&gt;hid&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:11px&quot;&gt;report parser&lt;br&gt;keys · typed text (layout)&lt;br&gt;mouse &amp;amp; touch motion&lt;br&gt;gamepad layer · controls&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=4;" vertex="1" parent="fork"><mxGeometry x="460" y="70" width="180" height="120" as="geometry"/></mxCell><mxCell id="repo" value="lvgl_usb_hid  (this repo)" style="swimlane;startSize=28;fillColor=#d5e8d4;strokeColor=#82b366;html=1;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="940" y="60" width="250" height="240" as="geometry"/></mxCell><mxCell id="ptr" value="&lt;b&gt;Pointer indev&lt;/b&gt; + cursor&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;move · left click · wheel scroll&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="repo"><mxGeometry x="20" y="50" width="210" height="70" as="geometry"/></mxCell><mxCell id="kbd" value="&lt;b&gt;Keypad indev&lt;/b&gt; + focus group&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Tab · arrows · Enter · Esc · text&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="repo"><mxGeometry x="20" y="150" width="210" height="70" as="geometry"/></mxCell><mxCell id="lvgl" value="&lt;b&gt;LVGL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;upstream ESPHome&lt;br&gt;screens &amp;amp; widgets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1250" y="135" width="150" height="100" as="geometry"/></mxCell><mxCell id="auto" value="&lt;b&gt;Your YAML automations&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;on_key · on_text · on_pointer · on_control&lt;br&gt;(media keys, gamepads, rumble, shortcuts)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="650" y="360" width="250" height="80" as="geometry"/></mxCell><mxCell id="e1" value="USB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="dev" target="host"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="device" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;fontSize=11;" edge="1" parent="fork" source="host" target="hidc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="reports" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;fontSize=11;" edge="1" parent="fork" source="hidc" target="hid"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="pointer events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="hid" target="ptr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="key + text events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="hid" target="kbd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;" edge="1" parent="1" source="ptr" target="lvgl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;" edge="1" parent="1" source="kbd" target="lvgl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="all events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;dashed=1;fontSize=11;" edge="1" parent="1" source="hid" target="auto"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="USB task → lock-free queue → ESPHome main loop" style="text;html=1;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="fork"><mxGeometry x="240" y="196" width="190" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
